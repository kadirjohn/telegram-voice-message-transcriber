# ── Application ──────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── Telegram ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
ALLOW_ADMIN_PRIVATE_TRANSCRIPTION=false

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://transcriber:transcriber@postgres:5432/transcriber

# ── Redis / Queue ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=transcriptions
WORKER_COUNT=2

# ── UstaGPT ─────────────────────────────────────────────────────────────
USTAGPT_BASE_URL=https://api.ustagpt.com.tr
USTAGPT_API_KEY=
USTAGPT_PRIMARY_MODEL=gemini-3.8-flash
USTAGPT_FALLBACK_MODELS=whisper-1,gpt-4o-mini-transcribe,gpt-4o-transcribe
USTAGPT_LANGUAGE=tr
USTAGPT_RESPONSE_FORMAT=json
USTAGPT_CONNECT_TIMEOUT_SECONDS=10
USTAGPT_READ_TIMEOUT_SECONDS=120
USTAGPT_RETRY_DELAY_SECONDS=30

# ── Voice / Media ───────────────────────────────────────────────────────
MAX_VOICE_FILE_BYTES=20971520
MAX_VOICE_DURATION_SECONDS=3600
FFMPEG_TIMEOUT_SECONDS=120

# ── Transcript Storage ───────────────────────────────────────────────────
STORE_TRANSCRIPTS=true
TRANSCRIPT_RETENTION_HOURS=24
SHOW_MODEL_FOOTER=false
